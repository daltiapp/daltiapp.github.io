{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daltiapp.github.io/schemas/agility-library-v1.schema.json",
  "title": "AgilityKorea image library v1",
  "description": "대회 출진표·코스맵·결과 이미지와 독립 코스맵 자료실의 앱 배포 계약.",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataVersion",
    "updatedAt",
    "mapCategories",
    "events",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataVersion": {
      "type": "string",
      "pattern": "^\\d{8}\\.[1-9]\\d*$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mapCategories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mapCategory"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "courseMapGroups": {
      "type": "array",
      "description": "대회별 코스맵 묶음. 구버전 앱을 위해 assets의 동일 자료를 보존한다.",
      "items": {
        "$ref": "#/$defs/courseMapGroup"
      }
    },
    "eventGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventGroup"
      },
      "description": "대회별 출진표·코스맵·결과 asset ID 참조. 결과 공개 전후 동일 eventId를 유지한다."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mapCategory": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "enum": [
            "ranking",
            "promotion",
            "awc",
            "training"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "name",
        "startDate",
        "endDate",
        "competitionGroup",
        "organizer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "startDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "endDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "competitionGroup": {
          "enum": [
            "OFFICIAL_PROMOTION",
            "UNOFFICIAL_PROMOTION_EVENT",
            "RANKING_EVENT",
            "INTERNATIONAL_EVENT",
            "OTHER_EVENT"
          ]
        },
        "organizer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "url",
        "thumbnailUrl",
        "width",
        "height",
        "mimeType"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "thumbnailUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https://"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "mimeType": {
          "type": "string",
          "pattern": "^image/"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "postUrl"
      ],
      "properties": {
        "provider": {
          "enum": [
            "kakao",
            "manual"
          ]
        },
        "channelId": {
          "type": "string",
          "minLength": 1
        },
        "channelName": {
          "type": "string",
          "minLength": 1
        },
        "postId": {
          "type": "string",
          "minLength": 1
        },
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "postTitle": {
          "type": "string",
          "minLength": 1
        },
        "postUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https://"
        },
        "publishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "imageOrder": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "kakao"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "channelId",
              "channelName",
              "postId",
              "mediaId",
              "postTitle",
              "publishedAt",
              "imageOrder"
            ],
            "properties": {
              "postUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "publishedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "eventIds",
        "mapCategories",
        "notice",
        "image",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "entry_list",
            "course_map",
            "result"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "eventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ranking",
              "promotion",
              "awc",
              "training"
            ]
          }
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "resultType": {
          "enum": [
            "image",
            "site"
          ],
          "description": "결과의 원문 형식. 생략한 기존 자료는 image로 읽는다."
        },
        "recordPath": {
          "type": "string",
          "pattern": "^\\./records/[A-Za-z0-9][A-Za-z0-9_-]*\\.json$",
          "description": "site 결과의 공개 기록 JSON. 자료실 JSON 파일 위치 기준 상대 경로."
        },
        "entryListPath": {
          "type": "string",
          "pattern": "^\\./records/waldbow-\\d+-entries\\.json$",
          "description": "사이트 출진표의 마스킹된 표 JSON. 자료실 JSON 파일 위치 기준 상대 경로."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "course_map"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "mapCategories": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "mapCategories": {
                "maxItems": 0
              },
              "eventIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "result"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "resultType": {
                      "const": "site"
                    }
                  },
                  "required": [
                    "resultType"
                  ]
                },
                "then": {
                  "required": [
                    "recordPath"
                  ]
                },
                "else": {
                  "properties": {
                    "recordPath": false
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "resultType": false,
              "recordPath": false
            }
          }
        },
        {
          "if": {
            "required": [
              "entryListPath"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "entry_list"
              }
            }
          }
        }
      ]
    },
    "channel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "provider",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "kakao",
            "manual"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false
    },
    "courseMapGroup": {
      "type": "object",
      "required": [
        "id",
        "eventId",
        "maps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "eventId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "maps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/asset"
              },
              {
                "properties": {
                  "kind": {
                    "const": "course_map"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "eventGroup": {
      "type": "object",
      "required": [
        "eventId",
        "entryListIds",
        "courseMapIds",
        "resultIds"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "entryListIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "courseMapIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resultIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
